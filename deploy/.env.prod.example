# Copiar como .env.prod en la raíz del repo (junto a docker-compose.prod.yml) y completar.
# Nunca commitear .env.prod real (ya está en .gitignore).

# Dominio que apunta (registro A) a la IP pública de la instancia de Oracle Cloud.
DOMAIN=tudominio.com

# Correo para el registro de la cuenta de Let's Encrypt (avisos de expiración, nada más).
LETSENCRYPT_EMAIL=tu-correo@ejemplo.com

# Poner en 1 para probar el flujo con el entorno de pruebas de Let's Encrypt (certificado
# no válido para el navegador, pero sin límite de intentos) antes de pedir el real.
LETSENCRYPT_STAGING=0

# Contraseña del superusuario de Postgres dentro del contenedor (no se usa desde la app).
POSTGRES_SUPERUSER_PASSWORD=cambiar-por-una-clave-larga-y-aleatoria

# Contraseña real de todo_quality_app (el rol con el que se conecta la API). Reemplaza el
# valor de ejemplo que trae 004_app_role.sql — ver 016_set_app_password_from_env.sh.
APP_DB_PASSWORD=cambiar-por-otra-clave-larga-y-aleatoria

# Secreto para firmar los JWT de sesión. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
