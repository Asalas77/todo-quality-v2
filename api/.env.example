# La app se conecta con el rol sin BYPASSRLS. Usar postgres aquí desactiva el
# aislamiento entre empresas sin que nada falle visiblemente.
DB_HOST=localhost
DB_PORT=5432
DB_USER=todo_quality_app
DB_PASSWORD=cambiar_en_despliegue
DB_NAME=todoquality

JWT_SECRET=generar-uno-largo-y-aleatorio-por-entorno
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

PORT=4000
CORS_ORIGIN=http://localhost:4173

# Carpeta donde se guardan las fotos de evidencia de inspecciones (una subcarpeta por
# tenant). Relativa al directorio de trabajo del proceso.
UPLOADS_DIR=./uploads

# Usada para construir el enlace de recuperación de contraseña. Sin servicio de email
# configurado todavía, el enlace se devuelve directo en la respuesta de /auth/olvide-contrasena
# (solo si NODE_ENV != production) — reemplazar por un envío real de correo antes de producción.
FRONTEND_URL=http://localhost:4173
